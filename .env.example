# OpenAI API key – required for Microsoft/Azure queries only
OPENAI_API_KEY=

# Root folder for local file search
LOCAL_FILE_ROOT=./data/sample_files

# Microsoft Learn MCP remote endpoint
MICROSOFT_LEARN_MCP_URL=https://learn.microsoft.com/api/mcp

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# OpenAI model to use for Microsoft Learn queries
MODEL_NAME=gpt-4o
